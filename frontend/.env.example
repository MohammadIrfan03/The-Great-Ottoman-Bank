# API Gateway base URL.
# Local development:
# VITE_API_BASE_URL=http://localhost:8089
#
# If frontend and gateway are exposed from the same host:
# VITE_API_BASE_URL=http://YOUR_HOST:8089
#
# If omitted, client.js falls back to:
# http://<current-browser-hostname>:8089
VITE_API_BASE_URL=http://localhost:8089
